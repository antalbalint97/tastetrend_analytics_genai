{
  "openapi": "3.0.1",
  "info": {
    "title": "Search Reviews API",
    "version": "1.0.0"
  },
  "paths": {
    "/search": {
      "post": {
        "summary": "Search restaurant reviews",
        "description": "Performs a semantic vector search over restaurant reviews and returns the most relevant matches.",
        "operationId": "search_reviews",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query"],
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "Natural language query to search restaurant reviews, e.g. 'What do customers complain about in Riverside?'"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful search returning matching reviews",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "description": "List of matching restaurant reviews",
                      "items": {
                        "type": "object",
                        "properties": {
                          "review_id":       { "type": "string",  "description": "Unique review identifier" },
                          "restaurant_name": { "type": "string",  "description": "Name or location of the restaurant" },
                          "rating":          { "type": "number",  "description": "Customer rating (1-5 scale)" },
                          "text":            { "type": "string",  "description": "Full review text" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
